{
  "name": "@sumirea/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "The stable public programmatic API that composes core and adapters for embedders and surfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc --build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@sumirea/adapters": "workspace:*",
    "@sumirea/core": "workspace:*",
    "@sumirea/schema": "workspace:*"
  },
  "devDependencies": {
    "@sumirea/eslint-config": "workspace:*",
    "@sumirea/typescript-config": "workspace:*",
    "typescript": "^5.5.0"
  }
}
