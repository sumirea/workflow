{
  "manifest_version": 3,
  "name": "Sumirea — Waiting for You",
  "version": "0.0.1",
  "description": "Notifies you when Claude Code Web is waiting for you, and brings you back to the tab. It never clicks or approves anything.",
  "permissions": ["notifications", "storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["shared/claude-signals.js", "shared/waiting-edge.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Sumirea — Waiting for You"
  }
}
