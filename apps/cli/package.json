{
  "name": "@sumirea/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line surface for running Sumirea workflows in terminals and CI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sumirea": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc --build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@sumirea/sdk": "workspace:*"
  },
  "devDependencies": {
    "@sumirea/eslint-config": "workspace:*",
    "@sumirea/typescript-config": "workspace:*",
    "typescript": "^5.5.0"
  }
}
